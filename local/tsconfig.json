{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*", "packages/**/*", "services/**/*", "apps/kiosk/src/**/*", "apps/kiosk/vite.config.ts", "tests/**/*", "*.config.*"],
  "exclude": ["**/node_modules", "**/dist"]
}
