# Initial deployment: HTTP on literal IPv4 loopback only.
APP_HOST=127.0.0.1
GATEWAY_PORT=3000
ATTENDANCE_PORT=3001
KNOWLEDGE_PORT=3002
ATTENDANCE_URL=http://127.0.0.1:3001
KNOWLEDGE_URL=http://127.0.0.1:3002
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave blank until a downloaded local model has been deliberately selected.
OLLAMA_CHAT_MODEL=
# setup:local generates this secret; never commit a populated environment file.
INTERNAL_SERVICE_TOKEN=
# Workspace-relative directory inside the ignored .runtime tree.
RUNTIME_DIR=.runtime
LOG_LEVEL=info
